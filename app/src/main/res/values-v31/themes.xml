         antes do app; aqui ele só herda o fundo do logo. A arte completa vem
         logo depois, na IntroScreen. -->
    <style name="Theme.BioScanner" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/ic_launcher_background</item>
        <item name="android:windowSplashScreenBackground">@color/ic_launcher_background</item>
    </style>
</resources>
